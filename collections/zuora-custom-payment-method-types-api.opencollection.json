      "items": [
        {
          "info": {
            "name": "Create a draft custom payment method type",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/open-payment-method-types",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              },
              {
                "name": "Accept-Encoding",
                "value": ""
              },
              {
                "name": "Content-Encoding",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Zuora-Track-Id",
                "value": ""
              },
              {
                "name": "Zuora-Entity-Ids",
                "value": ""
              },
              {
                "name": "Zuora-Org-Ids",
                "value": ""
              }
            ]
          },
          "docs": "Creates a draft version of a custom payment method type. Revision number 1 is assigned to this version. You can update your draft version through the [Update a custom payment method type](/api-references/api/operation/PUT_UpdateOpenPaymentMethodType/) operation. You must publish your draft version through the [Publish a custom payment method type](/api-references/api/operation/PUT_PublishOpenPaymentMethodType/) operation before your custom payment method type goes live.\n"
        },
        {
          "info": {
            "name": "Publish a custom payment method type",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/open-payment-method-types/publish/:paymentMethodTypeName",
            "headers": [
              {
                "name": "Accept-Encoding",
                "value": ""
              },
              {
                "name": "Content-Encoding",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Zuora-Track-Id",
                "value": ""
              },
              {
                "name": "Zuora-Entity-Ids",
                "value": ""
              },
              {
                "name": "Zuora-Org-Ids",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "paymentMethodTypeName",
                "value": "",
                "type": "path",
                "description": "The API name of the custom payment method type, such as `AmazonPay__c_12368`.\n"
              }
            ]
          },
          "docs": "Publish the latest draft revision of a specific custom payment method type.\n"
        },
        {
          "info": {
            "name": "Update a custom payment method type",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/open-payment-method-types/:paymentMethodTypeName",
            "headers": [
              {
                "name": "Accept-Encoding",
                "value": ""
              },
              {
                "name": "Content-Encoding",
                "value": ""
              },
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Zuora-Track-Id",
                "value": ""
              },
              {
                "name": "Zuora-Entity-Ids",
                "value": ""
              },
              {
                "name": "Zuora-Org-Ids",
                "value": ""
