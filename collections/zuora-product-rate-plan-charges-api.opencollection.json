          "info": {
            "name": "Retrieve a product rate plan charge",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/product-rate-plan-charges/:product-rate-plan-charge-key",
            "headers": [
              {
                "name": "Accept-Encoding",
                "value": ""
